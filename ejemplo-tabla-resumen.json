          "grid": { "sm": 12, "md": 12, "lg": 12 },
          "visible": true,
          "requerido": false,
          "validaciones": [],
          "metadatos": {
            "columnas": [
              {
                "nombre": "concepto",
                "etiqueta": "Concepto",
                "tipo": "texto"
              },
              {
                "nombre": "valor",
                "etiqueta": "Valor",
                "tipo": "calculado",
                "formatoNumero": {
                  "decimales": 2,
                  "prefijo": "$ ",
                  "sufijo": ""
                }
              }
            ],
            "filas": [
              {
                "id": "fila_subtotal_productos",
                "valores": {
                  "concepto": "Subtotal Productos",
                  "valor": "{tabla_productos.total.sum}"
                }
              },
              {
                "id": "fila_subtotal_servicios",
                "valores": {
                  "concepto": "Subtotal Servicios",
                  "valor": "{tabla_servicios.total.sum}"
                }
              },
              {
                "id": "fila_subtotal",
                "valores": {
                  "concepto": "Subtotal Total",
                  "valor": "{tabla_productos.total.sum} + {tabla_servicios.total.sum}"
                }
              },
              {
                "id": "fila_iva",
                "valores": {
                  "concepto": "IVA (19%)",
                  "valor": "({tabla_productos.total.sum} + {tabla_servicios.total.sum}) * 0.19"
                }
              },
              {
                "id": "fila_total",
                "valores": {
                  "concepto": "Total a Pagar",
                  "valor": "({tabla_productos.total.sum} + {tabla_servicios.total.sum}) * 1.19"
                }
              }
            ],
            "actualizacionAutomatica": true,
            "estiloTabla": {
              "bordered": true,
              "striped": false,
              "hover": false,
              "padding": "md"
            }
          }
